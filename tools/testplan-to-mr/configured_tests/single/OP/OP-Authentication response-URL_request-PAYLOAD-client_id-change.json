        "sessions": [
          "session0"
        ],
        "operations": [
          {
            "session": "session0",
            "action": "start"
          },
          {
            "action": "intercept",
            "from session": "session0",
            "then": "forward",
            "message type": "Authentication request",
            "decode operations": [
              {
                "from": "url",
                "decode param": "request",
                "type": "jwt",
                "edits": [
                  {
